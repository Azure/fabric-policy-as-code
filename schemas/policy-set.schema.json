{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FPAC Policy Set",
  "type": "object",
  "required": [
    "$schema",
    "name",
    "properties"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "required": [
        "pacOwnerId"
      ],
      "properties": {
        "pacOwnerId": {
          "type": "string",
          "minLength": 1
        },
        "fpacId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "properties": {
      "type": "object",
      "required": [
        "displayName",
        "policies"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "maxLength": 256
        },
        "policies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "parameters"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "parameters": {
                "type": "object",
                "description": "Reserved empty object. Concrete policy parameter values belong in deployment assignments.",
                "maxProperties": 0
              }
            },
            "additionalProperties": false
          }
        }
      }
      ,
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
